{
  "http": [
    "2",
    "1.1"
  ],
  "upstream_host": "api.cloudflare.com",
  "head_template": "POST /client/v4/accounts/ACCOUNT/ai/v1/chat/completions HTTP/1.1\r\nHost: api.cloudflare.com\r\nAuthorization: Bearer {KEY:53}\r\nContent-Type: application/json\r\nAccept-Encoding: identity\r\nConnection: close\r\nContent-Length: {LEN}\r\n\r\n",
  "key_alphabet": "[A-Za-z0-9_-]",
  "key_length": 53,
  "chat": {
    "cap_keys": [
      "max_tokens",
      "max_completion_tokens"
    ],
    "fixed_pins": [
      [
        "n",
        1
      ],
      [
        "stream",
        true
      ],
      [
        "stream_options",
        {
          "include_usage": true
        }
      ]
    ]
  },
  "max_tokens_cap": 4096,
  "notary_pubkey": "",
  "model_allowlist": [],
  "h2": {
    "probe_path": "/client/v4/user/tokens/verify",
    "idle_secs": 390,
    "max_requests": 100,
    "max_lifetime_s": 3600,
    "kinds": [
      "chat"
    ]
  }
}