{
  "http": [
    "1.1"
  ],
  "upstream_host": "opencode.ai",
  "head_template": "POST /zen/v1/chat/completions HTTP/1.1\r\nHost: opencode.ai\r\nAuthorization: Bearer {KEY:51}\r\nContent-Type: application/json\r\nAccept-Encoding: identity\r\nConnection: close\r\nContent-Length: {LEN}\r\n\r\n",
  "key_alphabet": "[A-Za-z0-9_-]",
  "key_length": 51,
  "chat": {
    "cap_keys": [
      "max_tokens",
      "max_completion_tokens"
    ],
    "fixed_pins": [
      [
        "n",
        1
      ],
      [
        "stream",
        true
      ],
      [
        "stream_options",
        {
          "include_usage": true
        }
      ]
    ]
  },
  "max_tokens_cap": 4096,
  "notary_pubkey": "",
  "model_allowlist": []
}