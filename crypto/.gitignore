# Rust build output (the workspace target dir lives under zkbench/).
/target/
/zkbench/target/
**/target/

# Per-session protocol artifacts (attestation/receipt/client records, sidecar
# logs). Regenerated by the tools in tools/ and client/bench-warm.sh; they can
# contain API-key-bearing responses from live runs, so they are never committed.
/runs/

# Local Python environment / caches used by tools/*.py.
.venv/
__pycache__/
*.pyc

# Node dependencies for the reference client.
client/node_modules/

# Local Cashu test wallet state (100 MB of throwaway test tokens).
/tools/.cashu/
