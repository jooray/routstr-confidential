# Rust build output (the workspace target dir lives under zkbench/).
/target/
/zkbench/target/
**/target/

# Per-session protocol artifacts (attestation/receipt/client records, sidecar
# logs). Regenerated by the tools in tools/ and client/bench-warm.sh; they can
# contain API-key-bearing responses from live runs, so they are not committed
# by default. The evidence directories under runs/ that are tracked were added
# on purpose (git add -f) after a secret scan; ci-offline.sh scans them on
# every push. Credentials of the gates' scratch nodes (api_keys.tsv) are
# random keys of a throwaway database and spend nothing elsewhere.
/runs/

# Local Python environment / caches used by tools/*.py.
.venv/
__pycache__/
*.pyc

# Node dependencies for the reference client.
client/node_modules/

# Local Cashu test wallet state (100 MB of throwaway test tokens).
/tools/.cashu/
